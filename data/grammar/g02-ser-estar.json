    { "type": "gap", "text": "Yo ___ (ser/estar) esperando un taxi.", "answer": "estoy", "hint": "gerade dabei", "expl": "estar + gerundio: estoy esperando = ich warte gerade." },
    { "type": "mc", "q": "„Ana ist gelangweilt“ heißt:", "options": ["Ana es aburrida.", "Ana está aburrida."], "answer": 1, "expl": "está aburrida = gelangweilt (Zustand). es aburrida = sie ist langweilig (Charakter)!" },
    { "type": "mc", "q": "¿___ listo? ¡Nos vamos!", "options": ["Eres", "Estás"], "answer": 1, "expl": "estar listo = fertig/bereit sein. ser listo = schlau sein." }
  ]
